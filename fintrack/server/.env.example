# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/fintrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fintrack
MONGODB_URI=

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Frontend URL allowed by CORS (comma-separate multiple URLs)
# Local: http://localhost:5173   Production: https://your-app.vercel.app
CLIENT_URL=

